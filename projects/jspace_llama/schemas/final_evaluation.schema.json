{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final_evaluation.schema.json",
  "title": "J-space final evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "run_id",
    "status",
    "reason",
    "manifest_sha256",
    "integrity",
    "primary",
    "paraphrases"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact": {"const": "final_evaluation"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "inconclusive"]},
    "reason": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "dependentRequired": {
            "stage": ["category"],
            "category": ["stage"]
          },
          "properties": {
            "code": {
              "enum": [
                "incomplete_provenance",
                "primary_gates_failed",
                "cuda_required",
                "asset_load_failed",
                "resource_exhausted",
                "tokenization_failed",
                "dimension_mismatch",
                "layer_band_invalid",
                "lens_integrity_failed",
                "readout_failed",
                "intervention_preparation_failed",
                "random_control_failed",
                "evaluation_data_invalid"
              ]
            },
            "message": {
              "enum": [
                "reproducible provenance is incomplete",
                "no alpha passed every primary-prompt gate",
                "a CUDA runtime is required",
                "model or lens asset loading failed",
                "GPU resources were exhausted",
                "intervention concepts are not valid single tokens",
                "model and lens dimensions do not match",
                "the selected layer band is invalid",
                "lens integrity verification failed",
                "workspace readout preparation failed",
                "intervention preparation failed",
                "random control preparation failed",
                "required aggregate evaluation data is missing"
              ]
            },
            "stage": {
              "enum": [
                "asset_load",
                "revision_resolution",
                "model_download",
                "lens_download",
                "model_load",
                "lens_load"
              ]
            },
            "category": {
              "enum": [
                "asset_failure",
                "gated_access_denied",
                "revision_not_found",
                "asset_not_found",
                "offline",
                "local_cache_missing",
                "hub_http_error",
                "io_error"
              ]
            }
          },
          "if": {"required": ["stage"]},
          "then": {
            "properties": {
              "code": {"const": "asset_load_failed"}
            }
          }
        }
      ]
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens_sha256",
        "lens_integrity_evaluated",
        "lens_integrity_verified"
      ],
      "properties": {
        "lens_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "lens_integrity_evaluated": {"type": "boolean"},
        "lens_integrity_verified": {"type": ["boolean", "null"]}
      }
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_name",
        "readout",
        "alphas",
        "passing_alphas",
        "passing_alpha_count"
      ],
      "properties": {
        "prompt_name": {"const": "main"},
        "readout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluated", "spider_present"],
          "properties": {
            "evaluated": {"type": "boolean"},
            "spider_present": {"type": ["boolean", "null"]}
          }
        },
        "alphas": {
          "type": "array",
          "items": {"$ref": "#/$defs/alphaEvaluation"}
        },
        "passing_alphas": {
          "type": "array",
          "items": {"type": "number"},
          "uniqueItems": true
        },
        "passing_alpha_count": {"type": "integer", "minimum": 0}
      }
    },
    "paraphrases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_count",
        "passing_prompt_alpha_count",
        "prompt_alphas"
      ],
      "properties": {
        "prompt_count": {"type": "integer", "minimum": 0},
        "passing_prompt_alpha_count": {"type": "integer", "minimum": 0},
        "prompt_alphas": {
          "type": "array",
          "items": {"$ref": "#/$defs/paraphraseAlphaEvaluation"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "success"}}
      },
      "then": {
        "properties": {
          "reason": {"type": "null"},
          "integrity": {
            "properties": {
              "lens_sha256": {"$ref": "#/$defs/sha256"},
              "lens_integrity_evaluated": {"const": true},
              "lens_integrity_verified": {"const": true}
            }
          },
          "primary": {
            "properties": {
              "readout": {
                "properties": {
                  "evaluated": {"const": true},
                  "spider_present": {"type": "boolean"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_evidence",
        "answer_parse",
        "target_entity_leakage",
        "degradation"
      ],
      "properties": {
        "answer_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eight", "six"],
          "properties": {
            "eight": {"type": "boolean"},
            "six": {"type": "boolean"}
          }
        },
        "answer_parse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": {
              "enum": ["unique", "negated", "conflicting", "no_answer"]
            },
            "value": {
              "type": ["string", "null"],
              "enum": ["six", "eight", null]
            }
          }
        },
        "target_entity_leakage": {"type": "boolean"},
        "degradation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["empty", "repetition", "incoherent"],
          "properties": {
            "empty": {"type": "boolean"},
            "repetition": {"type": "boolean"},
            "incoherent": {"type": "boolean"}
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readout_spider_present",
        "baseline_unique_eight",
        "baseline_not_degraded",
        "noop_unique_eight",
        "noop_not_degraded",
        "random_unique_non_six",
        "random_not_degraded",
        "target_unique_six",
        "target_no_ant",
        "target_not_degraded"
      ],
      "properties": {
        "readout_spider_present": {"type": "boolean"},
        "baseline_unique_eight": {"type": "boolean"},
        "baseline_not_degraded": {"type": "boolean"},
        "noop_unique_eight": {"type": "boolean"},
        "noop_not_degraded": {"type": "boolean"},
        "random_unique_non_six": {"type": "boolean"},
        "random_not_degraded": {"type": "boolean"},
        "target_unique_six": {"type": "boolean"},
        "target_no_ant": {"type": "boolean"},
        "target_not_degraded": {"type": "boolean"}
      }
    },
    "alphaEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alpha",
        "conditions",
        "gates",
        "passed",
        "reasons"
      ],
      "properties": {
        "alpha": {"type": "number"},
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "noop", "random", "target"],
          "properties": {
            "baseline": {"$ref": "#/$defs/classification"},
            "noop": {"$ref": "#/$defs/classification"},
            "random": {"$ref": "#/$defs/classification"},
            "target": {"$ref": "#/$defs/classification"}
          }
        },
        "gates": {"$ref": "#/$defs/gates"},
        "passed": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "paraphraseAlphaEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_name",
        "alpha",
        "conditions",
        "gates",
        "passed"
      ],
      "properties": {
        "prompt_name": {"type": "string", "minLength": 1},
        "alpha": {"type": "number"},
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "noop", "random", "target"],
          "properties": {
            "baseline": {"$ref": "#/$defs/classification"},
            "noop": {"$ref": "#/$defs/classification"},
            "random": {"$ref": "#/$defs/classification"},
            "target": {"$ref": "#/$defs/classification"}
          }
        },
        "gates": {"$ref": "#/$defs/gates"},
        "passed": {"type": "boolean"}
      }
    }
  }
}
