{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_manifest.schema.json",
  "title": "J-space execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "run_id",
    "started_at",
    "ended_at",
    "terminal_status",
    "status",
    "provenance_complete",
    "provenance",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact": {"const": "execution_manifest"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "terminal_status": {
      "enum": ["completed", "expected_failure", "unexpected_error"]
    },
    "status": {"enum": ["success", "inconclusive", "error"]},
    "provenance_complete": {"type": "boolean"},
    "reason": {"$ref": "#/$defs/reasonOrNull"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "model",
        "lens",
        "software",
        "hardware",
        "experiment"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "dirty"],
          "properties": {
            "commit": {"$ref": "#/$defs/sha40OrNull"},
            "dirty": {"type": ["boolean", "null"]}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "resolved_revision", "layer_count"],
          "properties": {
            "id": {
              "oneOf": [
                {"type": "null"},
                {"const": "meta-llama/Llama-3.1-8B-Instruct"}
              ]
            },
            "resolved_revision": {"$ref": "#/$defs/sha40OrNull"},
            "layer_count": {
              "oneOf": [
                {"type": "null"},
                {"const": 32}
              ]
            }
          }
        },
        "lens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo_id",
            "filename",
            "resolved_revision",
            "sha256",
            "size_bytes",
            "integrity_verified"
          ],
          "properties": {
            "repo_id": {
              "oneOf": [
                {"type": "null"},
                {"const": "neuronpedia/jacobian-lens"}
              ]
            },
            "filename": {
              "oneOf": [
                {"type": "null"},
                {
                  "const": "llama3.1-8b-it/jlens/Salesforce-wikitext/Llama-3.1-8B-Instruct_jacobian_lens.pt"
                }
              ]
            },
            "resolved_revision": {"$ref": "#/$defs/sha40OrNull"},
            "sha256": {"$ref": "#/$defs/sha256OrNull"},
            "size_bytes": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "integrity_verified": {"type": ["boolean", "null"]}
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "pytorch",
            "transformers",
            "huggingface_hub",
            "jspace",
            "jspace_commit"
          ],
          "properties": {
            "python": {"type": "string", "minLength": 1},
            "pytorch": {"type": "string", "minLength": 1},
            "transformers": {"type": "string", "minLength": 1},
            "huggingface_hub": {"type": "string", "minLength": 1},
            "jspace": {"type": "string", "minLength": 1},
            "jspace_commit": {"const": "04c822a255fe0a10d84e08ec499e5e09f4b7d37a"}
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_name", "cuda_version", "dtype"],
          "properties": {
            "gpu_name": {"type": ["string", "null"]},
            "cuda_version": {"type": ["string", "null"]},
            "dtype": {
              "oneOf": [
                {"type": "null"},
                {"const": "bfloat16"}
              ]
            }
          }
        },
        "experiment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "prompts",
            "generation",
            "layers",
            "alphas",
            "intervention"
          ],
          "properties": {
            "seed": {"type": ["integer", "null"]},
            "prompts": {
              "type": "array",
              "maxItems": 3,
              "prefixItems": [
                {
                  "allOf": [
                    {"$ref": "#/$defs/prompt"},
                    {
                      "properties": {
                        "name": {"const": "main"},
                        "text": {
                          "const": "The animal that spins webs has this many legs:"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {"$ref": "#/$defs/prompt"},
                    {
                      "properties": {
                        "name": {"const": "paraphrase_animal"},
                        "text": {
                          "const": "An animal that spins webs has how many legs?"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {"$ref": "#/$defs/prompt"},
                    {
                      "properties": {
                        "name": {"const": "paraphrase_creature"},
                        "text": {
                          "const": "How many legs does the creature that spins webs have?"
                        }
                      }
                    }
                  ]
                }
              ],
              "items": {
                "$ref": "#/$defs/prompt"
              }
            },
            "generation": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "max_new_tokens",
                    "do_sample",
                    "decoding",
                    "first_line"
                  ],
                  "properties": {
                    "max_new_tokens": {"const": 12},
                    "do_sample": {"const": false},
                    "decoding": {"const": "greedy"},
                    "first_line": {"const": false}
                  }
                }
              ]
            },
            "layers": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0, "maximum": 31},
              "uniqueItems": true
            },
            "alphas": {
              "type": "array",
              "items": {"type": "number"},
              "uniqueItems": true
            },
            "intervention": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_concept",
                    "target_concept",
                    "prefill_only",
                    "mode",
                    "random_control"
                  ],
                  "properties": {
                    "source_concept": {"const": "spider"},
                    "target_concept": {"const": "ant"},
                    "prefill_only": {"const": true},
                    "mode": {"const": "source_to_target_clamp"},
                    "random_control": {"const": "norm_matched_orthogonal"}
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "success"}}
      },
      "then": {
        "properties": {
          "provenance_complete": {"const": true},
          "provenance": {
            "properties": {
              "source": {
                "properties": {
                  "commit": {"$ref": "#/$defs/sha40"},
                  "dirty": {"type": "boolean"}
                }
              },
              "model": {
                "properties": {
                  "id": {"const": "meta-llama/Llama-3.1-8B-Instruct"},
                  "resolved_revision": {"$ref": "#/$defs/sha40"},
                  "layer_count": {"const": 32}
                }
              },
              "lens": {
                "properties": {
                  "repo_id": {"const": "neuronpedia/jacobian-lens"},
                  "filename": {
                    "const": "llama3.1-8b-it/jlens/Salesforce-wikitext/Llama-3.1-8B-Instruct_jacobian_lens.pt"
                  },
                  "resolved_revision": {"$ref": "#/$defs/sha40"},
                  "sha256": {"$ref": "#/$defs/sha256"},
                  "size_bytes": {"type": "integer", "minimum": 1},
                  "integrity_verified": {"const": true}
                }
              },
              "hardware": {
                "properties": {
                  "gpu_name": {"type": "string", "minLength": 1},
                  "cuda_version": {"type": "string", "minLength": 1},
                  "dtype": {"const": "bfloat16"}
                }
              },
              "experiment": {
                "properties": {
                  "prompts": {"minItems": 3, "maxItems": 3},
                  "generation": {"type": "object"},
                  "layers": {"minItems": 1},
                  "alphas": {"minItems": 1},
                  "intervention": {"type": "object"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "text",
        "instruction_sha256",
        "rendered_prompt_sha256"
      ],
      "properties": {
        "name": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "instruction_sha256": {"$ref": "#/$defs/sha256"},
        "rendered_prompt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha40OrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256OrNull": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "reasonOrNull": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "incomplete_provenance",
                "primary_gates_failed",
                "cuda_required",
                "asset_load_failed",
                "resource_exhausted",
                "tokenization_failed",
                "dimension_mismatch",
                "layer_band_invalid",
                "lens_integrity_failed",
                "readout_failed",
                "intervention_preparation_failed",
                "random_control_failed",
                "evaluation_data_invalid",
                "unexpected_error"
              ]
            },
            "message": {
              "enum": [
                "reproducible provenance is incomplete",
                "no alpha passed every primary-prompt gate",
                "a CUDA runtime is required",
                "model or lens asset loading failed",
                "GPU resources were exhausted",
                "intervention concepts are not valid single tokens",
                "model and lens dimensions do not match",
                "the selected layer band is invalid",
                "lens integrity verification failed",
                "workspace readout preparation failed",
                "intervention preparation failed",
                "random control preparation failed",
                "required aggregate evaluation data is missing",
                "unexpected programming error; see notebook traceback"
              ]
            }
          }
        }
      ]
    }
  }
}
